        </mxCell>
        <mxCell id="view" value="&lt;b&gt;&lt;font style=&quot;font-size:23px&quot;&gt;View&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font style=&quot;font-size:15px&quot; color=&quot;#3A675A&quot;&gt;src/screens&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;RecordForm submits the draft.&lt;br/&gt;Dashboard displays today’s totals." vertex="1" parent="1" style="rounded=1;arcSize=9;html=1;whiteSpace=wrap;fillColor=#F1F8F4;strokeColor=#9BBFA7;strokeWidth=1.6;fontFamily=Arial;fontSize=16;fontColor=#19362D;align=left;verticalAlign=middle;spacing=12;">
