  <diagram id="healthmate-architecture" name="MVVM architecture">
    <mxGraphModel grid="1" gridSize="10" guides="1" connect="1" arrows="1" page="1" pageScale="1" pageWidth="1260" pageHeight="550" background="#FFFFFF">
      <root>
